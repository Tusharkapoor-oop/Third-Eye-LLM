# WebLens environment. Copy to .env only if you need to override defaults.
# All variables use the WEBLENS_ prefix.

# Search providers, in fallback order. Supported: ddg,mwmbl,wikipedia,brave,tavily,searxng,bing
# Bing is optional: its HTML fallback is degraded and not part of the default chain.
WEBLENS_SEARCH_PROVIDERS=ddg,mwmbl,wikipedia
WEBLENS_SEARCH_MODE=fuse
# Fallback deadline for providers without an explicit provider deadline.
# Built-in deadlines: ddg=3.5s, mwmbl=2.5s, wikipedia=4.0s, tavily/brave=8.0s.
WEBLENS_PROVIDER_TIMEOUT_S=3.5
# Reuse identical fused search results for this many seconds. 0 disables it.
WEBLENS_SEARCH_CACHE_TTL_S=300

# Optional provider credentials / endpoints (keyless path needs none).
# Put real keys in .env, never in this example file.
# Tavily: https://app.tavily.com
# Brave: https://api.search.brave.com/app/keys
WEBLENS_BRAVE_API_KEY=
WEBLENS_TAVILY_API_KEY=
WEBLENS_SEARXNG_URL=http://localhost:8080

# Network and security
WEBLENS_CONNECT_TIMEOUT_S=4.0
WEBLENS_READ_TIMEOUT_S=12.0
WEBLENS_TOTAL_TIMEOUT_S=20.0
WEBLENS_RESEARCH_FETCH_TIMEOUT_S=8.0
WEBLENS_MAX_RESPONSE_BYTES=4000000
WEBLENS_MAX_REDIRECTS=5
WEBLENS_MAX_CONCURRENCY=8
WEBLENS_PER_HOST_CONCURRENCY=2
WEBLENS_ALLOW_PRIVATE_NETWORKS=false
WEBLENS_ALLOWED_HOSTS=
WEBLENS_BLOCK_HOSTS=
WEBLENS_ALLOW_BROWSER=false

# Cache
WEBLENS_CACHE_DIR=~/.weblens
WEBLENS_CACHE_ENABLED=true
# Logical payload cap in bytes; 0 disables eviction. SQLite/WAL overhead is extra.
WEBLENS_CACHE_MAX_BYTES=536870912
WEBLENS_PAGE_CACHE_TTL_S=86400
WEBLENS_ROBOTS_CACHE_TTL_S=3600
# Expired page entries may answer a transient fetch failure for this long.
# Stale responses keep their original fetched_at and are marked stale. 0 disables.
WEBLENS_CACHE_STALE_GRACE_S=604800

# Output budgets (cl100k_base tokens, envelope included)
WEBLENS_MAX_SEARCH_TOKENS=600
WEBLENS_MAX_EXTRACT_TOKENS=1500
WEBLENS_MAX_RESEARCH_TOKENS=2000
WEBLENS_DEFAULT_RESULTS=5

# Optional HTTP transport (stdio is the default and recommended local mode)
WEBLENS_HTTP_HOST=127.0.0.1
WEBLENS_HTTP_PORT=8765
WEBLENS_HTTP_TOKEN=
WEBLENS_LOG_LEVEL=INFO

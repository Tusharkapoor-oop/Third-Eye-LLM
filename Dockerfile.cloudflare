# Lean WebLens image for Cloudflare Containers.
#
# Cloudflare Containers run a normal linux/amd64 Docker image. This image
# intentionally installs the canonical Python package only: the root project's
# optional browser, hybrid-embedding, and Redis extras are not required for the
# MCP HTTP profile used by the Worker.

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/weblens/src \
    PORT=8080 \
    WEBLENS_HTTP_HOST=0.0.0.0 \
    WEBLENS_MCP_PROFILE=full \
    WEBLENS_CACHE_DIR=/tmp/weblens

# NOTE: deliberately NO WEBLENS_HTTP_PORT. Cloudflare Containers route to $PORT,
# and a hardcoded WEBLENS_HTTP_PORT is the more specific settings key, so it would
# silently outrank $PORT and the container would listen on a port the platform
# does not forward to. The CMD passes --port explicitly, which outranks both.

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The root .dockerignore excludes tests, caches, local virtualenvs, legacy code,
# and secrets while keeping the package sources available to the build.
COPY weblens/pyproject.toml weblens/README.md /app/weblens/
COPY weblens/src /app/weblens/src

RUN pip install --no-cache-dir --no-compile ./weblens \
    && find /app/weblens -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

RUN useradd --create-home --uid 10001 weblens \
    && mkdir -p /tmp/weblens \
    && chown -R weblens:weblens /app /tmp/weblens

USER weblens

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ.get('PORT','8080')+'/healthz', timeout=3).read()"

# --port is explicit so it outranks both $PORT and WEBLENS_HTTP_PORT.
CMD ["sh", "-c", "exec python -m weblens.cli serve --http --host 0.0.0.0 --port ${PORT:-8080} --profile full"]
